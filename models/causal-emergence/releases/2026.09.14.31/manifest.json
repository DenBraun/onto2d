  "manifestHash": "sha256:088a5709b7319f8060f17d380504b22a7d3745cce1d24e332c4548a22737edea",
  "model": {
    "description": "Partial source reconstruction of Level-0 definitions and scoped physical, optical, retinal, visual and neural records. Formal specifications, computational models, experimental preparations, reported observations and conditional interpretations have distinct meanings and evidence. Reviewed studies retain their own systems, selections, observables, uncertainty limits and unresolved contradictions. Physical records distinguish quantum-field definitions, scattering and decay measurements, Bell tests, vacuum quantities, QCD running, lattice spectra and charge searches. Calibrated masses, detector unloading times, storage-loss rates and intrinsic-lifetime interpretations are separate quantities. Neutron survival studies retain production years, diagnostic controls, shared data and non-decay-loss corrections. Cross-domain construction, universal carrier minima, downward causal rules and a derivation of quantum theory from Level 0 remain unestablished. No whole-graph scientific validation is claimed.",
    "id": "causal-emergence",
    "name": "Causal Emergence — Canonical Reconstruction",
    "status": "research-reconstruction-partial",
    "version": "2026.09.14.31"
  },
