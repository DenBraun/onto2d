{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical interaction comparison pilot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "date",
    "question",
    "scope",
    "sourceGroups",
    "families",
    "cases",
    "analogyIds",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "canonical-interaction-pilot"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "caseSelection",
        "physicalInstancesAdmitted",
        "independentScientificReviewComplete",
        "prospectiveValidation",
        "universalLawClaimed"
      ],
      "properties": {
        "kind": {
          "const": "retrospective-literature-comparison"
        },
        "caseSelection": {
          "const": "purposive-contrast-sample"
        },
        "physicalInstancesAdmitted": {
          "const": false
        },
        "independentScientificReviewComplete": {
          "const": false
        },
        "prospectiveValidation": {
          "const": "not-performed"
        },
        "universalLawClaimed": {
          "const": false
        }
      }
    },
    "sourceGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceIds",
          "split",
          "dependenceNote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "split": {
            "enum": [
              "development",
              "challenge"
            ]
          },
          "dependenceNote": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 2
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "eligibility",
          "scopedPrediction",
          "supportCriteria",
          "contraryCriteria",
          "inconclusiveCriteria",
          "overextension"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "eligibility": {
            "type": "string",
            "minLength": 1
          },
          "scopedPrediction": {
            "type": "string",
            "minLength": 1
          },
          "supportCriteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "contraryCriteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "inconclusiveCriteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "overextension": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceGroupId",
          "assessments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceGroupId": {
            "type": "string",
            "minLength": 1
          },
          "assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "familyId",
                "criterionId",
                "verdict",
                "observationIds",
                "rationale"
              ],
              "properties": {
                "familyId": {
                  "type": "string",
                  "minLength": 1
                },
                "criterionId": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "enum": [
                    "supports-scoped-instance",
                    "contradicts-overextension",
                    "inconclusive",
                    "outside-scope"
                  ]
                },
                "observationIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 12,
      "maxItems": 15
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrospectiveExposure",
        "splitRationale",
        "independentReview",
        "prospectiveEvaluation",
        "currentConclusion"
      ],
      "properties": {
        "retrospectiveExposure": {
          "type": "string",
          "minLength": 1
        },
        "splitRationale": {
          "type": "string",
          "minLength": 1
        },
        "independentReview": {
          "const": "not-performed"
        },
        "prospectiveEvaluation": {
          "const": "not-performed"
        },
        "currentConclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transferChecks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "familyId",
          "developmentCaseIds",
          "source",
          "question",
          "expectedDiscriminator",
          "contraryOutcome",
          "observations",
          "verdict",
          "rationale",
          "limits",
          "dependencyNote",
          "exposureNote",
          "canonicalAdmission",
          "blindProspective"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "familyId": {
            "type": "string",
            "minLength": 1
          },
          "developmentCaseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "authors",
              "year",
              "doi",
              "url",
              "readExtent",
              "locators",
              "readingLimit"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "authors": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "doi": {
                "type": "string",
                "pattern": "^10\\.[0-9]{4,9}/.+$"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "readExtent": {
                "enum": [
                  "full-primary-main",
                  "primary-main-and-selected-supplement",
                  "selected-primary-main-passages",
                  "abstract-only",
                  "metadata-only"
                ]
              },
              "locators": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "readingLimit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "expectedDiscriminator": {
            "type": "string",
            "minLength": 1
          },
          "contraryOutcome": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "statement",
                "locator"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "reported-observation",
                    "measurement-inference",
                    "model-result",
                    "source-interpretation",
                    "not-established"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "verdict": {
            "enum": [
              "supports-scoped-transfer",
              "contrary-to-prediction",
              "inconclusive"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencyNote": {
            "type": "string",
            "minLength": 1
          },
          "exposureNote": {
            "type": "string",
            "minLength": 1
          },
          "canonicalAdmission": {
            "const": false
          },
          "blindProspective": {
            "const": false
          }
        }
      }
    },
    "analogyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "passportField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingReason",
        "claimIds"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "missingReason": {
          "enum": [
            null,
            "not-reported",
            "not-reviewed",
            "not-applicable"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "missingReason": {
                "enum": [
                  "not-reported",
                  "not-reviewed",
                  "not-applicable"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "missingReason": {
                "type": "null"
              },
              "claimIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "resolvedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "sourceGroupId",
        "entityIds",
        "claimIds",
        "studyIds",
        "evidenceMode",
        "fields",
        "observations",
        "limitations",
        "assessments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "physics",
            "chemistry",
            "biochemistry"
          ]
        },
        "sourceGroupId": {
          "type": "string",
          "minLength": 1
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "studyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidenceMode": {
          "enum": [
            "experiment",
            "computation",
            "mixed"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participants",
            "changedFactor",
            "observable",
            "response",
            "conditions",
            "resources",
            "boundary",
            "timeScale",
            "controls",
            "interpretation",
            "uncertainty"
          ],
          "properties": {
            "participants": {
              "$ref": "#/definitions/passportField"
            },
            "changedFactor": {
              "$ref": "#/definitions/passportField"
            },
            "observable": {
              "$ref": "#/definitions/passportField"
            },
            "response": {
              "$ref": "#/definitions/passportField"
            },
            "conditions": {
              "$ref": "#/definitions/passportField"
            },
            "resources": {
              "$ref": "#/definitions/passportField"
            },
            "boundary": {
              "$ref": "#/definitions/passportField"
            },
            "timeScale": {
              "$ref": "#/definitions/passportField"
            },
            "controls": {
              "$ref": "#/definitions/passportField"
            },
            "interpretation": {
              "$ref": "#/definitions/passportField"
            },
            "uncertainty": {
              "$ref": "#/definitions/passportField"
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "statement",
              "claimIds",
              "studyIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "reported-observation",
                  "measurement-inference",
                  "model-result",
                  "source-interpretation",
                  "not-established"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "studyIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "familyId",
              "criterionId",
              "verdict",
              "observationIds",
              "rationale"
            ],
            "properties": {
              "familyId": {
                "type": "string",
                "minLength": 1
              },
              "criterionId": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supports-scoped-instance",
                  "contradicts-overextension",
                  "inconclusive",
                  "outside-scope"
                ]
              },
              "observationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "resolvedAnalogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "familyId",
        "caseIds",
        "fields",
        "correspondence",
        "breakdownConditions",
        "status",
        "physicalCausalClaim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": {
            "enum": [
              "participants",
              "changedFactor",
              "observable",
              "response",
              "conditions",
              "resources",
              "boundary",
              "timeScale",
              "controls",
              "interpretation",
              "uncertainty"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "correspondence": {
          "type": "string",
          "minLength": 1
        },
        "breakdownConditions": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "hypothesis"
        },
        "physicalCausalClaim": {
          "const": false
        }
      }
    }
  }
}
