  "scope": {
    "fieldRepresentation": "three complex fields psi_i(x,t)=f_i(x)*exp(i*omega_i*t) with real stationary envelopes f_i and omega_1+omega_2+omega_3=0",
    "domain": "one-dimensional finite interval [-L,L] with homogeneous Dirichlet boundaries",
    "energy": "E=integral(0.5*sum_i(abs(dt(psi_i))^2+abs(dx(psi_i))^2+m2_i*abs(psi_i)^2)-2*lambda*Re(psi_1*psi_2*psi_3)+0.25*g*(sum_i(abs(psi_i)^2))^2)dx",
    "equationsOfMotion": "d2_t(psi_i)=d2_x(psi_i)-m2_i*psi_i+2*lambda*conj(psi_j*psi_k)-g*(sum_l(abs(psi_l)^2))*psi_i",
    "stationaryEquations": "-d2_x(f_i)+(m2_i-omega_i^2)*f_i-2*lambda*f_j*f_k+g*(sum_l(f_l^2))*f_i=0",
    "conservedCharges": "Q_1=N_1-N_3 and Q_2=N_2-N_3 with N_i=integral(Im(conj(psi_i)*dt(psi_i)))dx; on a stationary state N_i=omega_i*integral(f_i^2)dx",
    "vacuumAdmissibility": "27*min_i(m2_i)*g-8*lambda^2>=0 implies U>=0 for every field value, so psi=0 is the global minimum; it is also necessary when the three mass-squared values are equal",
    "gamma": "integral((f_1+f_2+f_3)^2)dx evaluated on the stationary envelopes in the co-rotating phase-aligned frame",
    "staticStabilityPolicy": "charge-constrained count on the fine grid: n(H)=number of eigenvalues below minus the kernel tolerance of the real-amplitude and imaginary-phase block Hessians of E-Omega_1*Q_1-Omega_2*Q_2; p(d'')=number of positive eigenvalues of minus the symmetrized charge response dQ_a/dOmega_b; the count passes when the near-zero eigenvalues are exactly the three symmetry directions and n(H)=p(d'')",
    "dynamicStabilityPolicy": "complex velocity-Verlet evolution of the unperturbed state and of every preregistered perturbation at base, time-refined and space-refined resolution; a run departs when the density peak or the 90-percent support radius about the density centroid leaves the declared factor band relative to the unperturbed stationary state",
    "perturbationFrame": "perturbations are added to the envelope with zero velocity in the co-rotating frame, so the laboratory velocity of component i is i*omega_i*psi_i",
    "excluded": [
      "all parameter values",
      "all perturbation functions",
